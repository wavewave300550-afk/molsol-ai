{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "abm:orison_echo",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/abm/orison"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [0, 0, 0],
    "direction": ["math.random(-0.05, 0.05)", 1, "math.random(-0.05, 0.05)"]
   },
   "minecraft:particle_initial_speed": 0.25,
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": 0.7
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [0, 0, 0],
    "linear_drag_coefficient": 0.6
   },
   "minecraft:particle_appearance_billboard": {
    "size": ["0.9 * (1 - (v.particle_age / v.particle_lifetime) * 0.5)", "0.9 * (1 - (v.particle_age / v.particle_lifetime) * 0.5)"],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 64,
     "texture_height": 64,
     "uv": [0, 48],
     "uv_size": [16, 16]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     0.85,
     0.92,
     1.0,
     "math.clamp((v.particle_age / v.particle_lifetime) * 8, 0, 1) * math.clamp((1 - (v.particle_age / v.particle_lifetime)) * 5, 0, 1)"
    ]
   }
  }
 }
}
