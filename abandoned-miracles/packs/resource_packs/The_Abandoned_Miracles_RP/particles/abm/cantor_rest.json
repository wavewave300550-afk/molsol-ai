{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "abm:cantor_rest",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/abm/cantor"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [0, 0, 0],
    "direction": [0, 1, 0]
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "v.life"
   },
   "minecraft:particle_appearance_billboard": {
    "size": ["0.9 + math.sin(v.particle_age * 300) * 0.06", "0.9 + math.sin(v.particle_age * 300) * 0.06"],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 64,
     "texture_height": 64,
     "uv": [16, 32],
     "uv_size": [16, 16]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     0.9,
     0.96,
     1.0,
     "math.clamp((v.particle_age / v.particle_lifetime) * 8, 0, 1) * math.clamp((1 - (v.particle_age / v.particle_lifetime)) * 5, 0, 1)"
    ]
   }
  }
 }
}
