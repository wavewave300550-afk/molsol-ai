{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "abm:nomos_tg_arc",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/abm/nomos"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "math.clamp(v.r * math.abs(v.sweep) * 0.01745 * 2.88, 4, 500)"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [0, 0, 0],
    "direction": [0, 1, 0]
   },
   "minecraft:particle_initial_speed": 0,
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "v.life"
   },
   "minecraft:particle_motion_parametric": {
    "relative_position": ["math.cos((v.a0 + v.sweep * v.particle_random_1)) * v.r", 0, "math.sin((v.a0 + v.sweep * v.particle_random_1)) * v.r"]
   },
   "minecraft:particle_appearance_billboard": {
    "size": [0.34, 0.34],
    "facing_camera_mode": "emitter_transform_xz",
    "uv": {
     "texture_width": 64,
     "texture_height": 64,
     "uv": [0, 0],
     "uv_size": [16, 16]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     1.0,
     1.0,
     1.0,
     "(math.clamp((v.particle_age / v.particle_lifetime) * 8, 0, 1) * math.clamp((1 - (v.particle_age / v.particle_lifetime)) * 5, 0, 1)) * math.clamp((v.particle_age - v.particle_random_1 * 0.4) * 14, 0, 1) * (0.8 + 0.2 * math.sin(v.particle_age * 900))"
    ]
   }
  }
 }
}
