{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "abm:nomos",
   "materials": {
    "default": "entity_alphatest",
    "glow": "entity_emissive_alpha",
    "glass": "entity_alphablend"
   },
   "textures": {
    "default": "textures/entity/abm/nomos"
   },
   "geometry": {
    "default": "geometry.abm.nomos"
   },
   "scripts": {
    "initialize": ["v.yaw = q.property('abm:yaw');"],
    "pre_animation": [
     "v.yaw = math.lerprotate(v.yaw, q.property('abm:yaw'), 0.45);",
     "v.p2 = q.property('abm:phase') == 2;",
     "v.gait = q.modified_distance_moved * 0.25 * 0.9;",
     "v.turn = (v.yaw + 3600) / 60;",
     "v.go = math.clamp(q.modified_move_speed * 4, 0, 1);",
     "v.w_fl = math.mod(v.gait + 0.25, 1);",
     "v.t_fl = math.mod(v.turn + 0.25, 1);",
     "v.w_fr = math.mod(v.gait + 0.75, 1);",
     "v.t_fr = math.mod(v.turn + 0.75, 1);",
     "v.w_bl = math.mod(v.gait + 0, 1);",
     "v.t_bl = math.mod(v.turn + 0, 1);",
     "v.w_br = math.mod(v.gait + 0.5, 1);",
     "v.t_br = math.mod(v.turn + 0.5, 1);"
    ],
    "animate": ["face", "idle", "walk", "turn", "ctl_phase", "ctl_action", "ctl_feet"]
   },
   "animations": {
