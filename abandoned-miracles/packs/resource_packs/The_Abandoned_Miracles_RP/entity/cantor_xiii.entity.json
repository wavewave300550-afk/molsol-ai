    "pre_animation": [
     "v.p2 = q.property('abm:phase') == 2;",
     "v.duty = (v.p2 ? 0.66 : 0.72);",
     "v.gait = q.modified_distance_moved * (v.p2 ? 0.5 : 0.411);",
     "v.turn = (q.body_y_rotation + 3600) / 60;",
     "v.go = math.clamp(q.modified_move_speed * 5, 0, 1);",
     "v.w1 = math.mod(v.gait + 0, 1);",
     "v.t1 = math.mod(v.turn + 0, 1);",
     "v.w2 = math.mod(v.gait + 0.3333, 1);",
     "v.t2 = math.mod(v.turn + 0.3333, 1);",
     "v.w3 = math.mod(v.gait + 0.6667, 1);",
     "v.t3 = math.mod(v.turn + 0.6667, 1);",
     "v.lit = (q.property('abm:silent') == 1 ? 0 : (v.p2 ? math.sin(q.life_time * 520) + math.sin(q.life_time * 333) > -0.4 : math.sin(q.life_time * 720) > -0.35));"
    ],
    "animate": ["idle", "walk", "turn", "ctl_phase", "ctl_action", "ctl_feet"]
