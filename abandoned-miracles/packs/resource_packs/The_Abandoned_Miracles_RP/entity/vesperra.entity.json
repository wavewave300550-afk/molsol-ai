   "scripts": {
    "pre_animation": [
     "v.p2 = q.property('abm:phase') == 2;",
     "v.duty = (v.p2 ? 0.55 : 0.7);",
     "v.gait = q.modified_distance_moved * (v.p2 ? 0.42 : 0.526);",
     "v.turn = (q.body_y_rotation + 3600) / 60;",
     "v.go = math.clamp(q.modified_move_speed * 4, 0, 1);",
     "v.w_l1 = math.mod(v.gait + (v.p2 ? 0 : 0.66), 1);",
     "v.t_l1 = math.mod(v.turn + 0.66, 1);",
     "v.w_l2 = math.mod(v.gait + (v.p2 ? 0.5 : 0.33), 1);",
     "v.t_l2 = math.mod(v.turn + 0.33, 1);",
     "v.w_l3 = math.mod(v.gait + (v.p2 ? 0 : 0), 1);",
     "v.t_l3 = math.mod(v.turn + 0, 1);",
     "v.w_r1 = math.mod(v.gait + (v.p2 ? 0.5 : 0.16), 1);",
     "v.t_r1 = math.mod(v.turn + 0.16, 1);",
     "v.w_r2 = math.mod(v.gait + (v.p2 ? 0 : 0.83), 1);",
     "v.t_r2 = math.mod(v.turn + 0.83, 1);",
     "v.w_r3 = math.mod(v.gait + (v.p2 ? 0.5 : 0.5), 1);",
     "v.t_r3 = math.mod(v.turn + 0.5, 1);",
     "v.lane1 = (q.property('abm:variant') < 2 ? -1 : (q.property('abm:variant') < 4 ? 0 : 1));",
     "v.lane2 = ((q.property('abm:variant') == 0 || q.property('abm:variant') == 5) ? 0 : ((q.property('abm:variant') == 2 || q.property('abm:variant') == 4) ? -1 : 1));",
     "v.lane3 = ((q.property('abm:variant') == 0 || q.property('abm:variant') == 2) ? 1 : ((q.property('abm:variant') == 1 || q.property('abm:variant') == 4) ? 0 : -1));"
    ],
    "animate": ["idle", "walk", "turn", "ctl_phase", "ctl_action", "ctl_feet"]
