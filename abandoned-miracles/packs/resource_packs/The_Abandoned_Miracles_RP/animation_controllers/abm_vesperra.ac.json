       "two": "q.property('abm:phase') == 2"
      }
     ],
     "blend_transition": 0.25
    },
    "two": {
     "animations": ["p2_pose", "p2_flutter"],
     "transitions": [
      {
       "one": "q.property('abm:phase') == 1"
      }
     ],
     "blend_transition": 0.25
    }
   }
  },
  "controller.animation.abm.vesperra.feet": {
   "initial_state": "still",
   "states": {
    "still": {
     "transitions": [
      {
       "moving": "q.modified_move_speed > 0.12 && q.property('abm:anim') == 0"
      }
     ]
    },
    "moving": {
     "animations": ["footfalls"],
     "transitions": [
      {
       "still": "q.modified_move_speed < 0.06 || q.property('abm:anim') != 0"
      }
     ]
    }
   }
  },
  "controller.animation.abm.vesperra_heir": {
   "initial_state": "emerge",
   "states": {
    "emerge": {
     "animations": ["emerge"],
     "transitions": [
      {
       "idle": "q.all_animations_finished"
      }
     ],
     "blend_transition": 0.1
    },
    "idle": {
     "transitions": [
      {
       "bite": "q.property('abm:anim') == 1"
      }
     ],
     "blend_transition": 0.1
    },
    "bite": {
     "animations": ["bite"],
     "transitions": [
      {
       "idle": "q.property('abm:anim') != 1"
      }
     ],
     "blend_transition": 0.1
    }
