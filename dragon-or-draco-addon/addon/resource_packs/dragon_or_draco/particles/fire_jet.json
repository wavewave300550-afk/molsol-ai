{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "dod:fire_jet",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/dod_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.25 + v.jet_spread",
        "direction": [
          "variable.jet.direction_x + math.random(-0.12, 0.12)",
          "variable.jet.direction_y + math.random(-0.12, 0.12)",
          "variable.jet.direction_z + math.random(-0.12, 0.12)"
        ]
      },
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.jet.speed ?? { variable.jet.speed = 10; }; v.jet_spread = 0.2;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.32, 0.5)"
      },
      "minecraft:particle_initial_speed": "variable.jet.speed * math.random(0.8, 1.1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          3,
          0
        ],
        "linear_drag_coefficient": 2.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.6 + v.particle_age * 4.5",
          "0.6 + v.particle_age * 4.5"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFF4C8",
            "0.18": "#FFFFCD57",
            "0.45": "#FFFF6B1E",
            "0.75": "#E0B8281A",
            "1.0": "#00401010"
          }
        }
      }
    }
  }
}
