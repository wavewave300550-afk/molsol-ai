{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "dod:nostril_smoke",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/dod_fx"
      }
    },
    "components": {
