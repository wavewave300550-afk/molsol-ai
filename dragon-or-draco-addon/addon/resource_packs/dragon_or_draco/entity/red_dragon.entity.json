        "death_embers": "dod:death_embers",
        "fire_charge_core": "dod:fire_charge_core"
      },
      "sound_effects": {
        "bite": "mob.dod.red_dragon.bite",
        "buffet": "mob.dod.red_dragon.buffet",
        "death": "mob.dod.red_dragon.death",
        "fire_breath": "mob.dod.red_dragon.fire_breath",
