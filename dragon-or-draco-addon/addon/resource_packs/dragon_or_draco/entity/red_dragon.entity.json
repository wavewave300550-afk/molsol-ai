{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dod:red_dragon",
      "materials": {
        "default": "entity_emissive",
        "fire": "entity_beam_additive"
      },
      "textures": {
        "default": "textures/entity/red_dragon",
        "fire": "textures/entity/red_dragon_fire"
      },
      "geometry": {
        "default": "geometry.dod.red_dragon",
        "fire": "geometry.dod.red_dragon_fire"
      },
      "scripts": {
        "pre_animation": [
          "v.moving = math.clamp(q.modified_move_speed * 3.0, 0.0, 1.0);",
          "v.run_w = q.property('dod:run') ? v.moving : 0.0;",
          "v.walk_w = v.moving - v.run_w;"
        ],
        "animate": [
          "breathe",
          "move_controller",
          "action_controller",
          "look_controller",
          "hurt_controller"
        ],
        "should_update_bones_and_effects_offscreen": "1.0"
      },
      "animations": {
        "idle": "animation.dod.red_dragon.idle",
        "breathe": "animation.dod.red_dragon.breathe",
