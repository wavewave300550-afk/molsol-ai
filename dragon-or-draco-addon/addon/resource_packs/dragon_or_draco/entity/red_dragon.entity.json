        "controller.render.dod.red_dragon",
        {
          "controller.render.dod.red_dragon_fire": "q.property('dod:action') == 'fire_breath'"
        }
      ],
      "spawn_egg": {
        "texture": "dod_red_dragon_spawn_egg"
      },
      "enable_attachables": false
    }
