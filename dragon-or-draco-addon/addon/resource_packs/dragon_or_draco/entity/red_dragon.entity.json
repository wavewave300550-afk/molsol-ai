        "wing_stretch": "animation.dod.red_dragon.wing_stretch",
        "takeoff": "animation.dod.red_dragon.takeoff",
        "fly": "animation.dod.red_dragon.fly",
        "glide": "animation.dod.red_dragon.glide",
        "landing": "animation.dod.red_dragon.landing",
