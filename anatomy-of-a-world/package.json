{
  "name": "the-anatomy-of-a-world",
  "private": true,
  "version": "1.0.3",
  "description": "Minecraft Bedrock add-on: THE ANATOMY OF A WORLD - experimental colossal bosses",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "python3 tools/build.py",
    "validate": "python3 tools/validate.py",
    "sim": "node tools/sim/run.mjs",
    "preview": "node tools/preview/voxels.mjs tools/preview/out/mountain.bin && node tools/preview/shots_models.mjs",
    "test": "npm run typecheck && npm run build && npm run validate && npm run sim"
  },
  "devDependencies": {
    "@minecraft/server": "2.11.0",
    "@minecraft/server-ui": "2.3.0",
    "@minecraft/vanilla-data": "1.26.60",
    "three": "^0.187.0",
    "typescript": "5.6.3"
  }
}
