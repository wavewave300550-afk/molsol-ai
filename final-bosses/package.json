{
  "name": "final-bosses",
  "private": true,
  "version": "1.0.0",
  "description": "Minecraft Bedrock add-on: five Final Bosses",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "python3 tools/build.py",
    "validate": "python3 tools/validate.py",
    "smoke": "node tools/smoke/smoke.mjs",
    "preview": "python3 tools/preview.py docs/previews",
    "test": "npm run typecheck && npm run build && npm run validate && npm run smoke"
  },
  "devDependencies": {
    "@minecraft/server": "2.11.0",
    "@minecraft/server-ui": "2.3.0",
    "typescript": "5.6.3"
  }
}
