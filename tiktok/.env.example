# Copy to tiktok/.env (git-ignored) for local narration. Never commit real keys.
# In GitHub Actions these come from repository secrets/variables instead.

# ElevenLabs API key (repository secret ELEVENLABS_API_KEY in GitHub Actions).
ELEVENLABS_API_KEY=

# Optional. Leave empty to use the channel narrator, Madame Scientia
# (XAF1635HwW2TJGfbLzfc). Set it only to narrate with a different voice.
ELEVENLABS_VOICE_ID=

# Only if your organisation needs a Remotion company license.
REMOTION_LICENSE_KEY=
