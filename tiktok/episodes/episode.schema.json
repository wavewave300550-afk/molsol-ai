{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "episode",
        "pipeline-test"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "const": "th"
    },
    "durationTier": {
      "type": "string",
      "enum": [
        "standard",
        "complex"
      ]
    },
    "complexJustification": {
      "type": "string"
    },
    "voice": {
      "type": "object",
      "properties": {
        "voiceId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "similarityBoost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.\\d{4,9}\\/\\S+$"
          },
          "accessed": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "citation"
        ],
        "additionalProperties": false
      }
    },
    "scenes": {
      "minItems": 2,
      "maxItems": 14,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "title"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subtitle": {
                    "type": "string"
                  },
                  "kicker": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "title"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "molecule"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "formula": {
                    "type": "string"
                  },
                  "atoms": {
                    "minItems": 1,
                    "maxItems": 40,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "element": {
                          "type": "string",
                          "pattern": "^[A-Z][a-z]?$"
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "element",
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "bonds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        },
                        "order": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 1
                            },
                            {
                              "type": "number",
                              "const": 2
                            },
                            {
                              "type": "number",
                              "const": 3
                            }
                          ]
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "reveal": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "caption": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "title",
                  "atoms",
                  "bonds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "chart"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bars": {
                    "minItems": 1,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sublabel": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        },
                        "cue": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "label",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "note": {
                    "type": "string"
                  },
                  "decimals": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "type",
                  "title",
                  "unit",
                  "bars"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "process"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "steps": {
                    "minItems": 2,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "detail": {
                          "type": "string"
                        },
                        "cue": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "type",
                  "title",
                  "steps"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "fact"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "items": {
                    "minItems": 1,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "decimals": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4
                        },
                        "prefix": {
                          "type": "string"
                        },
                        "suffix": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "cue": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "value",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "type",
                  "title",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "title": {
                    "type": "string"
                  },
                  "src": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "credit": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "src",
                  "alt",
                  "credit"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "sources"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "title"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sourceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "factual": {
            "default": true,
            "type": "boolean"
          },
          "cues": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "narration",
          "visual"
        ],
        "additionalProperties": false
      }
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "approvedBy": {
              "type": "string",
              "minLength": 1
            },
            "approvedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "durationTier": {
              "type": "string",
              "enum": [
                "standard",
                "complex"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "approvedBy",
            "approvedAt",
            "contentHash",
            "durationTier"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "title",
    "language",
    "durationTier",
    "sources",
    "scenes"
  ],
  "additionalProperties": false
}
