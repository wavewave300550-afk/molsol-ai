{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "grizzly_oath:flame",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/grizzly_oath_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.08,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.45, 0.75)"
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 1.1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.4,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 0.4) * (1 - 0.35 * (v.particle_age / v.particle_lifetime))",
          "(v.size ?? 0.4) * 1.4 * (1 - 0.2 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              0,
              192
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              64,
              0
            ],
            "frames_per_second": 20,
            "max_frame": 4,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 1)",
          "(v.color.g ?? 0.15)",
          "(v.color.b ?? 0.1)",
          "(v.color.a ?? 1) * (1 - (v.particle_age / v.particle_lifetime))"
        ]
      }
    }
  }
}
