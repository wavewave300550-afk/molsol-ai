{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "grizzly_oath:dust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/grizzly_oath_fx"
      }
    },
    "components": {
