          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.45,
          0.39,
          0.36,
          "0.65 * (1 - (v.particle_age / v.particle_lifetime))"
