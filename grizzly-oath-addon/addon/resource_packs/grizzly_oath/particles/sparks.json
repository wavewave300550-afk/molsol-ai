{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "grizzly_oath:sparks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/grizzly_oath_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 8)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.1,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.18, 0.34)"
      },
      "minecraft:particle_initial_speed": "math.random(4, 9) * (v.speed ?? 1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -7,
          0
        ],
        "linear_drag_coefficient": 5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.26 * (1 - (v.particle_age / v.particle_lifetime)) + 0.05",
          "0.035 * (1 - 0.5 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            128,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "0.92 - 0.8 * (v.particle_age / v.particle_lifetime)",
          "0.65 - 0.6 * (v.particle_age / v.particle_lifetime)",
          "1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
