{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "grizzly_oath:crack",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/grizzly_oath_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 1.2)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.radius ?? 2) * math.min(1, v.particle_age * 14)",
          "(v.radius ?? 2) * math.min(1, v.particle_age * 14)"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            64,
            128
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 1)",
          "(v.color.g ?? 0.15)",
          "(v.color.b ?? 0.1)",
          "(v.color.a ?? 1) * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))"
        ]
      }
    }
  }
}
