  "description": {
   "identifier": "dragon_dominion:gharvok",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "intact": "textures/entity/gharvok_intact",
    "cracked": "textures/entity/gharvok_cracked",
    "broken": "textures/entity/gharvok_broken"
   },
   "geometry": {
    "default": "geometry.dragon_dominion.gharvok"
   },
   "scripts": {
    "scale": "0.8",
    "pre_animation": [
     "v.busy = q.property('dragon_dominion:anim') > 0;",
     "v.fold_t = q.property('dragon_dominion:flight') > 0 ? 0.0 : (q.property('dragon_dominion:anim') == 8 ? 0.0 : (q.property('dragon_dominion:anim') == 9 ? 0.0 : (q.property('dragon_dominion:anim') == 10 ? 0.35 : (q.property('dragon_dominion:anim') == 11 ? 0.0 : (q.property('dragon_dominion:anim') == 15 ? 0.7 : (q.property('dragon_dominion:anim') == 17 ? 0.35 : 1.0))))));",
     "v.fold = math.lerp(v.fold ?? 1.0, v.fold_t, math.min(1.0, q.delta_time * 6.0));",
     "v.yaw_d = q.body_y_rotation - (v.last_yaw ?? q.body_y_rotation);",
     "v.yaw_d = v.yaw_d > 180 ? v.yaw_d - 360 : (v.yaw_d < -180 ? v.yaw_d + 360 : v.yaw_d);",
     "v.last_yaw = q.body_y_rotation;",
     "v.turn = math.lerp(v.turn ?? 0.0, v.yaw_d / math.max(q.delta_time, 0.016), math.min(1.0, q.delta_time * 5.0));",
     "v.turn_dir = math.clamp(v.turn / 60.0, -1.0, 1.0);",
     "v.walking = q.property('dragon_dominion:gait') == 1 || (q.property('dragon_dominion:gait') == 0 && q.ground_speed > 0.3);",
     "v.running = q.property('dragon_dominion:gait') == 2 || (q.property('dragon_dominion:gait') == 0 && q.ground_speed > 4.5);",
     "v.injured = math.lerp(v.injured ?? 0.0, (q.property('dragon_dominion:phase') >= 3 && !v.busy) ? 1.0 : 0.0, math.min(1.0, q.delta_time * 2.0));"
    ],
    "animate": [
     "locomotion",
     "action",
     {
      "wing_fold": "v.fold"
     },
     "flinch",
     {
      "injured_overlay": "v.injured"
     }
    ],
    "should_update_bones_and_effects_offscreen": "1.0"
   },
