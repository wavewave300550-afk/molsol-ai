      }
     ]
    },
    "death": {
     "animations": [
      "death"
     ],
     "blend_transition": 0.3,
     "transitions": [
      {
       "none": "q.property('dragon_dominion:anim') != 17"
      }
     ]
    }
   }
  },
  "controller.animation.dragon_dominion.gharvok.flinch": {
   "initial_state": "calm",
   "states": {
    "calm": {
     "transitions": [
      {
       "flinch": "q.hurt_time > 0 && !v.busy && q.is_alive"
      }
     ]
    },
    "flinch": {
     "animations": [
      "hit_reaction"
     ],
     "blend_transition": 0.1,
     "transitions": [
      {
       "calm": "q.all_animations_finished || v.busy"
      }
     ]
    }
   }
  }
 }
}