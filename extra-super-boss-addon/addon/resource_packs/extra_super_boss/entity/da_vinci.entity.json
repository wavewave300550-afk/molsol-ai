    "wings_controller": "controller.animation.esb.da_vinci.wings",
    "wings_flap": "animation.esb.da_vinci.wings_flap",
    "wings_folded": "animation.esb.da_vinci.wings_folded",
    "wings_hidden": "animation.esb.da_vinci.wings_hidden",
    "wings_swept": "animation.esb.da_vinci.wings_swept",
    "wings_unfold": "animation.esb.da_vinci.wings_unfold"
   },
