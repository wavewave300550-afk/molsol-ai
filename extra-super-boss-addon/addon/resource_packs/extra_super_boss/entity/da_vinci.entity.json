{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "esb:da_vinci",
   "materials": {
    "default": "entity_emissive",
    "halo": "entity_beam_additive"
   },
   "textures": {
    "default": "textures/entity/da_vinci",
    "halo": "textures/entity/vitruvian_sigil"
   },
   "geometry": {
    "default": "geometry.esb.da_vinci",
    "halo": "geometry.esb.da_vinci_halo"
   },
   "render_controllers": [
    "controller.render.esb.da_vinci",
    {
     "controller.render.esb.da_vinci_halo": "q.property('esb:action') == 'ultimate'"
    }
   ],
   "spawn_egg": {
    "base_color": "#7E1F2A",
    "overlay_color": "#D6AE5E"
   },
   "enable_attachables": false,
   "scripts": {
    "scale": "1.6",
    "animate": [
     "idle",
     {
      "walk": "!(q.property('esb:action') == 'dive_rise' || q.property('esb:action') == 'dive_hover' || q.property('esb:action') == 'dive_strike' || q.property('esb:action') == 'ultimate')"
     },
     {
      "look": "!(q.property('esb:action') == 'death' || q.property('esb:action') == 'transform' || q.property('esb:action') == 'intro' || q.property('esb:action') == 'ultimate')"
     },
     "wings_controller",
     "attack_controller",
     "action_controller"
    ],
    "should_update_bones_and_effects_offscreen": "1.0"
   },
   "animations": {
    "action_controller": "controller.animation.esb.da_vinci.action",
    "attack_controller": "controller.animation.esb.da_vinci.attack",
    "death": "animation.esb.da_vinci.death",
    "dive_hover": "animation.esb.da_vinci.dive_hover",
    "dive_rise": "animation.esb.da_vinci.dive_rise",
