    "intro": "animation.esb.da_vinci.intro",
    "look": "animation.esb.da_vinci.look",
    "quake": "animation.esb.da_vinci.quake",
    "slash": "animation.esb.da_vinci.slash",
    "transform": "animation.esb.da_vinci.transform",
    "ultimate": "animation.esb.da_vinci.ultimate",
    "vitruvian": "animation.esb.da_vinci.vitruvian",
