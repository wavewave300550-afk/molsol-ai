   "scripts": {
    "pre_animation": [
     "v.plr_ph = q.modified_distance_moved * 38.17;",
     "v.plr_tc = math.cos(v.plr_ph) * q.modified_move_speed * 57.3;",
     "v.plr_mv = math.clamp(q.modified_move_speed, 0, 1);",
     "v.plr_still = 1 - math.clamp(q.modified_move_speed * 5, 0, 1);",
     "v.plr_spr = q.is_sprinting ? 1 : 0;",
     "v.plr_walk = 1 - v.plr_spr;",
     "v.plr_bob = ((v.plr_walk) * (math.clamp(q.modified_move_speed / 0.8, 0, 1.25)) * ((-0.1724 + -0.6789 * math.cos(v.plr_ph * 2) + 0.1233 * math.sin(v.plr_ph * 2) + -0.02197 * math.cos(v.plr_ph * 4)) - (0.002))) + ((v.plr_spr) * (v.plr_mv) * ((-0.4172 + -1.036 * math.cos(v.plr_ph * 2) + 0.1665 * math.sin(v.plr_ph * 2)) - (0.002)));"
    ],
    "animate": [
     {
