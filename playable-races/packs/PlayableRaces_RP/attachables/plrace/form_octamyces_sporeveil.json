    "land_hard": "animation.plrace.octamyces.land_hard"
   },
   "particle_effects": {
    "spores": "plrace:geo_spores",
    "motes": "plrace:parallax_motes",
    "echo": "plrace:parallax_echo"
   },
   "scripts": {
    "pre_animation": [
     "v.plr_ph = q.modified_distance_moved * 38.17;",
     "v.plr_tc = math.cos(v.plr_ph) * q.modified_move_speed * 57.3;",
     "v.plr_mv = math.clamp(q.modified_move_speed, 0, 1);",
     "v.plr_still = 1 - math.clamp(q.modified_move_speed * 5, 0, 1);",
     "v.plr_spr = q.is_sprinting ? 1 : 0;",
     "v.plr_walk = 1 - v.plr_spr;",
     "v.plr_bob = 0;",
     "v.oct_b1 = math.mod(q.life_time, 8.7);",
     "v.oct_b2 = math.mod(q.life_time + 4.9, 13.3);",
     "v.oct_b1 = math.clamp(v.oct_b1 / 0.2, 0, 1) - math.clamp((v.oct_b1 - 0.27) / 0.3, 0, 1);",
     "v.oct_b2 = math.clamp(v.oct_b2 / 0.2, 0, 1) - math.clamp((v.oct_b2 - 0.27) / 0.3, 0, 1);",
     "v.oct_blink = math.max(math.max(v.oct_b1, v.oct_b2), (q.is_sleeping ? 1 : 0));",
     "v.oct_blink = v.oct_blink * v.oct_blink * (3 - 2 * v.oct_blink);"
    ],
    "animate": [
     {
      "first_person": "c.is_first_person"
     },
     {
      "third_person": "!c.is_first_person"
     },
     {
      "steady": "!c.is_first_person"
     },
     {
      "vigil_plain": "!c.is_first_person"
     },
     {
      "gaze": "!c.is_first_person"
     },
     {
      "blink_wide": "!c.is_first_person"
     },
     {
      "locomotion": "!c.is_first_person && !q.is_riding && !q.is_gliding && !q.is_swimming"
     },
     {
      "airborne": "!c.is_first_person && !q.is_on_ground && !q.is_in_water && !q.is_riding && !q.is_gliding"
     },
     {
      "landing": "!c.is_first_person && !q.is_riding"
     },
     {
      "attack": "!c.is_first_person"
     },
     {
      "swim": "!c.is_first_person && (q.is_swimming || (q.is_in_water && !q.is_on_ground))"
     },
     {
      "hurt": "!c.is_first_person && q.hurt_time > 0"
     },
     {
      "hurt_lids": "!c.is_first_person && q.hurt_time > 0"
     },
     "intro_sporeveil",
     {
      "fx_sporeveil": "!c.is_first_person"
     },
     {
      "sporeveil_loop": "!c.is_first_person"
     }
    ]
   },
   "render_controllers": [
    "controller.render.plrace.form",
    "controller.render.plrace.form_cutout",
    "controller.render.plrace.octamyces_accent_c",
    "controller.render.plrace.octamyces_accent_l",
    "controller.render.plrace.octamyces_accent_f"
   ]
  }
 }
