    "hurt": "animation.plrace.octamyces.hurt",
    "hurt_lids": "animation.plrace.octamyces.hurt_lids",
    "intro_sporeveil": "animation.plrace.octamyces.intro_sporeveil",
    "fx_sporeveil": "animation.plrace.octamyces.fx_sporeveil",
    "sporeveil_loop": "animation.plrace.octamyces.sporeveil_loop",
    "life": "animation.plrace.octamyces.life",
    "vigil_wait": "animation.plrace.octamyces.vigil_wait",
    "surveil": "animation.plrace.octamyces.surveil",
