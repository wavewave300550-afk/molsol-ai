   "particle_effects": {
    "motes": "plrace:royal_mote",
    "decree": "plrace:decree_burst",
    "shadow": "plrace:procession_shadow"
   },
   "scripts": {
    "pre_animation": [
     "v.plr_ph = q.modified_distance_moved * 38.17;",
     "v.plr_tc = math.cos(v.plr_ph) * q.modified_move_speed * 57.3;",
     "v.plr_mv = math.clamp(q.modified_move_speed, 0, 1);",
     "v.plr_still = 1 - math.clamp(q.modified_move_speed * 5, 0, 1);",
     "v.plr_spr = q.is_sprinting ? 1 : 0;",
     "v.plr_walk = 1 - v.plr_spr;",
     "v.plr_bw0 = 0.3034 + 0.1695 * math.cos(v.plr_ph * 2) - 0.05457 * math.cos(v.plr_ph * 4);",
     "v.plr_br0 = 0.3478 + 0.1809 * math.cos(v.plr_ph * 2) - 0.0683 * math.cos(v.plr_ph * 4);",
     "v.plr_bob = ((v.plr_walk) * (math.clamp(q.modified_move_speed / 0.8, 0, 1.25)) * ((v.plr_bw0) - (0.002))) + ((v.plr_spr) * (v.plr_mv) * ((v.plr_br0) - (0.002)));"
    ],
    "animate": [
     {
      "first_person": "c.is_first_person"
     },
     {
      "third_person": "!c.is_first_person"
     },
     {
      "life": "!c.is_first_person"
     },
     {
      "halo_spin": "!c.is_first_person"
     },
     "appendages",
     {
      "fidget": "!c.is_first_person"
     },
     {
      "locomotion": "!c.is_first_person && !q.is_riding && !q.is_gliding && !q.is_swimming"
     },
     {
      "airborne": "!c.is_first_person && !q.is_on_ground && !q.is_in_water && !q.is_riding && !q.is_gliding"
     },
     {
      "landing": "!c.is_first_person && !q.is_riding"
     },
     {
      "attack": "!c.is_first_person"
     },
     {
      "hurt": "!c.is_first_person && q.hurt_time > 0"
     },
     "intro_nocturne",
     {
      "fx_nocturne": "!c.is_first_person"
     },
     {
      "nocturne_loop": "!c.is_first_person"
     }
    ]
   },
   "render_controllers": [
    "controller.render.plrace.form",
    "controller.render.plrace.nurariten_accent_c",
    "controller.render.plrace.nurariten_accent_l",
    "controller.render.plrace.nurariten_accent_f"
   ]
  }
 }
