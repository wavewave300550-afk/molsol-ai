{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.armor": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "variable.is_enchanted ? Material.enchanted : Material.default"
    }
   ],
   "textures": [
    "variable.has_trim ? variable.trim_path : Texture.default",
    "Texture.enchanted"
   ],
   "part_visibility": [
    {
     "*": "!query.is_item_name_any('slot.armor.head', 0, 'plrace:form_salamander', 'plrace:form_salamander_bloom', 'plrace:form_salamander_dormant', 'plrace:form_salamander_predatory', 'plrace:form_salamander_rooted', 'plrace:form_golem', 'plrace:form_golem_siege', 'plrace:form_golem_bastion', 'plrace:form_golem_arcane', 'plrace:form_golem_scattered', 'plrace:form_golem_disrupted', 'plrace:form_jackalope', 'plrace:form_jackalope_hunt', 'plrace:form_jackalope_awakened', 'plrace:form_jackalope_awakened_hunt')"
    }
   ]
  }
 }
}
