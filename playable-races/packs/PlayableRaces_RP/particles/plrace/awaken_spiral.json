{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "plrace:awaken_spiral",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/plrace/races/particles/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_steady": {
    "spawn_rate": 60,
    "max_particles": 90
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 1.4
   },
   "minecraft:emitter_shape_point": {},
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": 1.2
   },
   "minecraft:particle_motion_parametric": {
    "relative_position": [
     "math.cos(v.emitter_age * 520 + variable.particle_random_1 * 60) * (1.2 - v.particle_age)",
     "-1.6 + v.particle_age * 1.8",
     "math.sin(v.emitter_age * 520 + variable.particle_random_1 * 60) * (1.2 - v.particle_age)"
    ]
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.07",
     "0.07"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      0,
      32
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "gradient": {
      "0.0": "#ffff4a5a",
      "1.0": "#00b0001a"
     },
     "interpolant": "v.particle_age / v.particle_lifetime"
    }
   }
  }
 }
}
