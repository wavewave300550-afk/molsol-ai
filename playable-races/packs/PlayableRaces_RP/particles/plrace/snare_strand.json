{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "plrace:snare_strand",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/plrace/races/particles/particles_vfx"
   }
  },
  "events": {
   "l0": {
    "particle_effect": {
     "effect": "plrace:vx_snare_charge",
     "type": "emitter"
    }
   },
   "l1": {
    "particle_effect": {
     "effect": "plrace:vx_snare_flash",
     "type": "emitter"
    }
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 40
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_point": {},
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.7 + v.particle_random_2 * 0.4"
   },
   "minecraft:particle_motion_parametric": {
    "relative_position": [
     "v.dx * v.len * v.particle_random_1 * math.min(1, v.particle_age * 8)",
     "v.dy * v.len * v.particle_random_1 * math.min(1, v.particle_age * 8) + math.sin(v.particle_random_1 * 180) * 0.2 - v.particle_age * 0.4 * v.particle_random_1",
     "v.dz * v.len * v.particle_random_1 * math.min(1, v.particle_age * 8)"
    ]
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.09 * math.clamp((1 - (v.particle_age / v.particle_lifetime)) * 3, 0, 1)",
     "0.75 * math.clamp((1 - (v.particle_age / v.particle_lifetime)) * 3, 0, 1)"
    ],
    "facing_camera_mode": "lookat_direction",
    "uv": {
     "texture_width": 512,
     "texture_height": 512,
     "uv": [
      0,
      448
     ],
     "uv_size": [
      32,
      32
     ]
    },
    "direction": {
     "mode": "custom",
     "custom_direction": [
      "v.dx",
      "v.dy",
      "v.dz"
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "gradient": {
      "0.00": [
       1.0,
       1.0,
       1.0,
       1.0
      ],
      "0.30": [
       1.0,
       0.373,
       0.659,
       1.0
      ],
      "1.00": [
       0.365,
       1.0,
       0.604,
       0.0
      ]
     },
     "interpolant": "(v.particle_age / v.particle_lifetime)"
    }
   },
   "minecraft:emitter_lifetime_events": {
    "creation_event": [
     "l0",
     "l1"
    ]
   }
  }
 }
}
