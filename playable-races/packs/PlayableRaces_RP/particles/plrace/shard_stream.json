{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "plrace:shard_stream",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/plrace/races/particles/particles_vfx"
   }
  },
  "events": {
   "l0": {
    "particle_effect": {
     "effect": "plrace:vx_shard_flash",
     "type": "emitter"
    }
   },
   "l1": {
    "particle_effect": {
     "effect": "plrace:vx_shard_rocks",
     "type": "emitter"
    }
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 22
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_point": {},
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.5 + v.particle_random_2 * 0.15"
   },
   "minecraft:particle_motion_parametric": {
    "relative_position": [
     "v.dx * v.len * math.pow(math.min(1, v.particle_age / 0.55), 1.4) + math.sin(v.particle_age * 600 + v.particle_random_1 * 360) * 0.3",
     "v.dy * v.len * math.pow(math.min(1, v.particle_age / 0.55), 1.4) + math.sin(math.min(1, v.particle_age / 0.55) * 180) * 1.2",
     "v.dz * v.len * math.pow(math.min(1, v.particle_age / 0.55), 1.4) + math.cos(v.particle_age * 600 + v.particle_random_1 * 360) * 0.3"
    ]
   },
   "minecraft:particle_initial_spin": {
    "rotation": "v.particle_random_1 * 360",
    "rotation_rate": 500
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.22",
     "0.22"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 512,
     "texture_height": 512,
     "uv": [
      480,
      448
     ],
     "uv_size": [
      32,
      32
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": {
     "gradient": {
      "0.00": [
       1.0,
       0.945,
       0.784,
       1.0
      ],
      "0.40": [
       1.0,
       0.71,
       0.278,
       1.0
      ],
      "1.00": [
       1.0,
       0.478,
       0.165,
       1.0
      ]
     },
     "interpolant": "(v.particle_age / v.particle_lifetime)"
    }
   },
   "minecraft:emitter_lifetime_events": {
    "creation_event": [
     "l0",
     "l1"
    ]
   }
  }
 }
}
