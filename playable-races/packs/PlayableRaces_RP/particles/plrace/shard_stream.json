{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "plrace:shard_stream",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/plrace/races/particles/particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 18
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_sphere": {
    "radius": 0.8
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": 0.55
   },
   "minecraft:particle_motion_parametric": {
    "relative_position": [
     "v.dx * v.len * math.pow(v.particle_age / 0.55, 1.4) + math.sin(v.particle_age * 600 + variable.particle_random_1 * 360) * 0.3",
     "v.dy * v.len * math.pow(v.particle_age / 0.55, 1.4) + math.sin(v.particle_age / 0.55 * 180) * 1.2",
     "v.dz * v.len * math.pow(v.particle_age / 0.55, 1.4) + math.cos(v.particle_age * 600 + variable.particle_random_2 * 360) * 0.3"
    ]
   },
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_1 * 360",
    "rotation_rate": 500
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.2",
     "0.2"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      0,
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": "#ff35353b"
   },
   "minecraft:particle_appearance_lighting": {}
  }
 }
}
