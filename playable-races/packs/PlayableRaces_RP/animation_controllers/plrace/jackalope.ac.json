{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.plrace.jackalope.landing": {
   "initial_state": "ground",
   "states": {
    "ground": {
     "transitions": [
      {
       "air": "!q.is_on_ground && !q.is_in_water"
      }
     ]
    },
    "air": {
     "transitions": [
      {
       "falling_hard": "q.vertical_speed < -14"
      },
      {
       "falling": "q.vertical_speed < -6"
      },
      {
       "ground": "q.is_on_ground || q.is_in_water"
      }
     ]
    },
    "falling": {
     "transitions": [
      {
       "falling_hard": "q.vertical_speed < -14"
      },
      {
       "land": "q.is_on_ground"
      },
      {
       "ground": "q.is_in_water"
      }
     ]
    },
    "falling_hard": {
     "transitions": [
      {
       "land_hard": "q.is_on_ground"
      },
      {
       "ground": "q.is_in_water"
      }
     ]
    },
    "land": {
     "animations": [
      "land"
     ],
     "transitions": [
      {
       "air": "!q.is_on_ground && !q.is_in_water"
      },
      {
       "ground": "q.all_animations_finished"
      }
     ]
    },
    "land_hard": {
     "animations": [
      "land_hard"
     ],
     "transitions": [
      {
       "air": "!q.is_on_ground && !q.is_in_water"
      },
      {
       "ground": "q.all_animations_finished"
      }
     ]
    }
   }
  },
  "controller.animation.plrace.jackalope.fidget": {
   "initial_state": "wait",
   "states": {
    "wait": {
     "animations": [
      "fidget_wait"
     ],
     "transitions": [
      {
       "moving": "q.modified_move_speed > 0.04 || !q.is_on_ground || q.is_in_water || q.hurt_time > 0 || q.is_sneaking || q.is_riding || q.is_sleeping || q.is_gliding"
      },
      {
       "fidget_groom": "q.all_animations_finished && (math.mod(math.floor(q.life_time * 1.9), 4) == 0 && !q.is_item_equipped(0) && !q.is_item_equipped(1))"
      },
      {
       "fidget_sentinel": "q.all_animations_finished && (math.mod(math.floor(q.life_time * 1.9), 4) == 1)"
      },
      {
       "fidget_thump": "q.all_animations_finished && (math.mod(math.floor(q.life_time * 1.9), 4) == 2)"
      },
      {
       "fidget_stretch": "q.all_animations_finished && (math.mod(math.floor(q.life_time * 1.9), 4) == 3 && !q.is_item_equipped(0) && !q.is_item_equipped(1))"
      },
      {
       "rest": "q.all_animations_finished"
      }
     ]
    },
    "moving": {
     "transitions": [
      {
       "wait": "!(q.modified_move_speed > 0.04 || !q.is_on_ground || q.is_in_water || q.hurt_time > 0 || q.is_sneaking || q.is_riding || q.is_sleeping || q.is_gliding)"
      }
     ],
     "blend_transition": 0.2
    },
    "rest": {
     "animations": [
      "fidget_rest"
     ],
     "transitions": [
      {
       "moving": "q.modified_move_speed > 0.04 || !q.is_on_ground || q.is_in_water || q.hurt_time > 0 || q.is_sneaking || q.is_riding || q.is_sleeping || q.is_gliding"
      },
      {
       "wait": "q.all_animations_finished"
      }
     ]
    },
    "fidget_groom": {
     "animations": [
      "fidget_groom"
     ],
     "blend_transition": 0.3,
     "transitions": [
      {
       "moving": "q.modified_move_speed > 0.04 || !q.is_on_ground || q.is_in_water || q.hurt_time > 0 || q.is_sneaking || q.is_riding || q.is_sleeping || q.is_gliding"
      },
      {
       "wait": "q.all_animations_finished"
      }
     ]
    },
    "fidget_sentinel": {
     "animations": [
      "fidget_sentinel"
     ],
     "blend_transition": 0.3,
     "transitions": [
      {
       "moving": "q.modified_move_speed > 0.04 || !q.is_on_ground || q.is_in_water || q.hurt_time > 0 || q.is_sneaking || q.is_riding || q.is_sleeping || q.is_gliding"
      },
      {
       "wait": "q.all_animations_finished"
      }
     ]
    },
    "fidget_thump": {
     "animations": [
      "fidget_thump"
     ],
     "blend_transition": 0.3,
     "transitions": [
      {
       "moving": "q.modified_move_speed > 0.04 || !q.is_on_ground || q.is_in_water || q.hurt_time > 0 || q.is_sneaking || q.is_riding || q.is_sleeping || q.is_gliding"
      },
      {
       "wait": "q.all_animations_finished"
      }
     ]
    },
    "fidget_stretch": {
     "animations": [
      "fidget_stretch"
     ],
     "blend_transition": 0.3,
     "transitions": [
      {
       "moving": "q.modified_move_speed > 0.04 || !q.is_on_ground || q.is_in_water || q.hurt_time > 0 || q.is_sneaking || q.is_riding || q.is_sleeping || q.is_gliding"
      },
      {
       "wait": "q.all_animations_finished"
      }
     ]
    }
   }
  }
 }
}
