{
  "name": "grimoire-rebirth-of-the-arcane",
  "version": "1.0.0",
  "private": true,
  "description": "Grimoire: Rebirth of the Arcane - Minecraft Bedrock add-on (3 grimoires, 18 spells)",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "esbuild src/main.ts --bundle --format=esm --target=es2022 --external:@minecraft/server --outfile=behavior_packs/grimoire_bp/scripts/main.js --legal-comments=none",
    "assets": "python3 tools/build.py",
    "test": "node tests/run.mjs",
    "validate": "python3 tools/validate.py",
    "package": "python3 tools/package.py",
    "build": "npm run assets && npm run typecheck && npm run bundle && npm run test && npm run validate && npm run package"
  },
  "devDependencies": {
    "@minecraft/server": "2.11.0",
    "@minecraft/vanilla-data": "1.26.60",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
