{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.grimoire.fx_circle_b": {
   "initial_state": "p0",
   "states": {
    "p0": {
     "transitions": [
      {
       "p1": "q.property('grimoire:phase') == 1"
      },
      {
       "p2": "q.property('grimoire:phase') == 2"
      },
      {
       "p3": "q.property('grimoire:phase') == 3"
      },
      {
       "p15": "q.property('grimoire:phase') == 15"
      }
     ],
     "blend_transition": 0.12
    },
    "p1": {
     "transitions": [
      {
       "p0": "q.property('grimoire:phase') == 0"
      },
      {
       "p2": "q.property('grimoire:phase') == 2"
      },
      {
       "p3": "q.property('grimoire:phase') == 3"
      },
      {
       "p15": "q.property('grimoire:phase') == 15"
      }
     ],
     "blend_transition": 0.12,
     "animations": [
      "form",
      "spin"
     ]
    },
    "p2": {
     "transitions": [
      {
       "p0": "q.property('grimoire:phase') == 0"
      },
      {
       "p1": "q.property('grimoire:phase') == 1"
      },
      {
       "p3": "q.property('grimoire:phase') == 3"
      },
      {
       "p15": "q.property('grimoire:phase') == 15"
      }
     ],
     "blend_transition": 0.12,
     "animations": [
      "spin"
     ]
    },
    "p3": {
     "transitions": [
      {
       "p0": "q.property('grimoire:phase') == 0"
      },
      {
       "p1": "q.property('grimoire:phase') == 1"
      },
      {
       "p2": "q.property('grimoire:phase') == 2"
      },
      {
       "p15": "q.property('grimoire:phase') == 15"
      }
     ],
     "blend_transition": 0.12,
     "animations": [
      "fast"
     ]
    },
    "p15": {
     "transitions": [
      {
       "p0": "q.property('grimoire:phase') == 0"
      },
      {
       "p1": "q.property('grimoire:phase') == 1"
      },
      {
       "p2": "q.property('grimoire:phase') == 2"
      },
      {
       "p3": "q.property('grimoire:phase') == 3"
      }
     ],
     "blend_transition": 0.12,
     "animations": [
      "dissolve"
     ]
    }
   }
  },
  "controller.animation.grimoire.fx_circle_b.pulse": {
   "initial_state": "idle",
   "states": {
    "idle": {
     "on_entry": [
      "v.last_aux = q.property('grimoire:aux');"
     ],
     "transitions": [
      {
       "pulse": "q.property('grimoire:aux') != v.last_aux"
      }
     ]
    },
    "pulse": {
     "animations": [
      "pulse"
     ],
     "on_entry": [
      "v.last_aux = q.property('grimoire:aux');"
     ],
     "transitions": [
      {
       "idle": "q.all_animations_finished"
      },
      {
       "pulse_again": "q.property('grimoire:aux') != v.last_aux"
      }
     ],
     "blend_transition": 0.05
    },
    "pulse_again": {
     "animations": [
      "pulse"
     ],
     "on_entry": [
      "v.last_aux = q.property('grimoire:aux');"
     ],
     "transitions": [
      {
       "idle": "q.all_animations_finished"
      },
      {
       "pulse": "q.property('grimoire:aux') != v.last_aux"
      }
     ],
     "blend_transition": 0.05
    }
   }
  }
 }
}