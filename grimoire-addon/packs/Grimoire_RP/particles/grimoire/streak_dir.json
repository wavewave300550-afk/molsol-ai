{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:streak_dir",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "4 * variable.count"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "0.5 * variable.radius",
    "direction": [
     "variable.dir.direction_x",
     "variable.dir.direction_y",
     "variable.dir.direction_z"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.25 + variable.particle_random_1 * 0.15"
   },
   "minecraft:particle_initial_speed": "(8 + variable.particle_random_2 * 6) * variable.dir.speed",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0,
     0
    ],
    "linear_drag_coefficient": 2
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.04 * variable.size",
     "0.5 * variable.size"
    ],
    "facing_camera_mode": "lookat_direction",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      64,
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "math.lerp(variable.color.r, variable.color2.r, variable.particle_random_4)",
     "math.lerp(variable.color.g, variable.color2.g, variable.particle_random_4)",
     "math.lerp(variable.color.b, variable.color2.b, variable.particle_random_4)",
     "math.clamp(1 - variable.particle_age / variable.particle_lifetime, 0, 1)"
    ]
   }
  }
 }
}