{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:petal_burst",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "12 * variable.count"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "0.5 * variable.radius",
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "1.0 + variable.particle_random_1 * 0.8"
   },
   "minecraft:particle_initial_speed": "(1 + variable.particle_random_2 * 3) * variable.radius",
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_3 * 360",
    "rotation_rate": "(variable.particle_random_4 - 0.5) * 400"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -2.5,
     0
    ],
    "linear_drag_coefficient": 1.6,
    "rotation_acceleration": 0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(0.08 + variable.particle_random_3 * 0.1) * variable.size",
     "(0.08 + variable.particle_random_3 * 0.1) * variable.size"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      112,
      0
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "math.lerp(variable.color.r, variable.color2.r, variable.particle_random_4)",
     "math.lerp(variable.color.g, variable.color2.g, variable.particle_random_4)",
     "math.lerp(variable.color.b, variable.color2.b, variable.particle_random_4)",
     "math.clamp(math.min(variable.particle_age * 8, (1 - variable.particle_age / variable.particle_lifetime) * 2.5), 0, 1)"
    ]
   }
  }
 }
}