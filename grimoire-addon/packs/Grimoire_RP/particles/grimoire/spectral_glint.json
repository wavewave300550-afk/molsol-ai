{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:spectral_glint",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "10 * variable.count"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "0.4 * variable.radius",
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.5 + variable.particle_random_1 * 0.5"
   },
   "minecraft:particle_initial_speed": "(1 + variable.particle_random_2 * 3) * variable.radius",
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_3 * 360",
    "rotation_rate": "180"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0,
     0
    ],
    "linear_drag_coefficient": 2.5,
    "rotation_acceleration": 0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(0.05 + variable.particle_random_3 * 0.08) * variable.size",
     "(0.05 + variable.particle_random_3 * 0.08) * variable.size"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      48,
      48
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "0.55 + 0.45 * math.cos((variable.particle_random_4) * 360)",
     "0.55 + 0.45 * math.cos((variable.particle_random_4) * 360 - 120)",
     "0.55 + 0.45 * math.cos((variable.particle_random_4) * 360 - 240)",
     "math.clamp(math.min(variable.particle_age * 8, (1 - variable.particle_age / variable.particle_lifetime) * 2.5), 0, 1)"
    ]
   }
  }
 }
}