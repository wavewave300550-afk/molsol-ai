{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:ring_dir",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "1"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "variable.dir.direction_x",
     "variable.dir.direction_y",
     "variable.dir.direction_z"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.4 * variable.life"
   },
   "minecraft:particle_initial_speed": "0.01",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0,
     0
    ],
    "linear_drag_coefficient": 0.0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.radius * (0.2 + 0.8 * math.sqrt(variable.particle_age / variable.particle_lifetime))",
     "variable.radius * (0.2 + 0.8 * math.sqrt(variable.particle_age / variable.particle_lifetime))"
    ],
    "facing_camera_mode": "direction_z",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      16,
      0
     ],
     "uv_size": [
      16,
      16
     ]
    },
    "direction": {
     "mode": "custom",
     "custom_direction": [
      "variable.dir.direction_x",
      "variable.dir.direction_y",
      "variable.dir.direction_z"
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "math.lerp(variable.color.r, variable.color2.r, variable.particle_random_4)",
     "math.lerp(variable.color.g, variable.color2.g, variable.particle_random_4)",
     "math.lerp(variable.color.b, variable.color2.b, variable.particle_random_4)",
     "math.clamp(1 - variable.particle_age / variable.particle_lifetime, 0, 1)"
    ]
   }
  }
 }
}