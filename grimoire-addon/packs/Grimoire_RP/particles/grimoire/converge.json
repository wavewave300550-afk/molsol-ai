{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:converge",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "18 * variable.count"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "variable.radius",
    "surface_only": true,
    "direction": "inwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.55 * variable.life"
   },
   "minecraft:particle_initial_speed": "variable.radius * 1.9 / variable.life",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0,
     0
    ],
    "linear_drag_coefficient": 0.0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(0.05 + variable.particle_random_3 * 0.07) * variable.size",
     "(0.05 + variable.particle_random_3 * 0.07) * variable.size"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      48,
      0
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "math.lerp(variable.color.r, variable.color2.r, variable.particle_random_4)",
     "math.lerp(variable.color.g, variable.color2.g, variable.particle_random_4)",
     "math.lerp(variable.color.b, variable.color2.b, variable.particle_random_4)",
     "math.clamp(math.min(variable.particle_age * 8, (1 - variable.particle_age / variable.particle_lifetime) * 2.5), 0, 1)"
    ]
   }
  }
 }
}