{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:shard_burst",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "12 * variable.count"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "0.3 * variable.radius",
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.6 + variable.particle_random_1 * 0.6"
   },
   "minecraft:particle_initial_speed": "(3 + variable.particle_random_2 * 5) * variable.radius",
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_3 * 360",
    "rotation_rate": "(variable.particle_random_4 - 0.5) * 720"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -14,
     0
    ],
    "linear_drag_coefficient": 1.2,
    "rotation_acceleration": 0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(0.08 + variable.particle_random_3 * 0.12) * variable.size",
     "(0.08 + variable.particle_random_3 * 0.12) * variable.size"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      80,
      0
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "math.lerp(variable.color.r, variable.color2.r, variable.particle_random_4)",
     "math.lerp(variable.color.g, variable.color2.g, variable.particle_random_4)",
     "math.lerp(variable.color.b, variable.color2.b, variable.particle_random_4)",
     "math.clamp(1 - variable.particle_age / variable.particle_lifetime, 0, 1)"
    ]
   },
   "minecraft:particle_motion_collision": {
    "collision_radius": 0.05,
    "coefficient_of_restitution": 0.1,
    "collision_drag": 4,
    "expire_on_contact": false
   }
  }
 }
}