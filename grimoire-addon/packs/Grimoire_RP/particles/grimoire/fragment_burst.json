{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:fragment_burst",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "14 * variable.count"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "0.4 * variable.radius",
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.7 + variable.particle_random_1 * 0.7"
   },
   "minecraft:particle_initial_speed": "(2 + variable.particle_random_2 * 4) * variable.radius",
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_3 * 360",
    "rotation_rate": "(variable.particle_random_4 - 0.5) * 900"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -6,
     0
    ],
    "linear_drag_coefficient": 1.5,
    "rotation_acceleration": 0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(0.05 + variable.particle_random_3 * 0.08) * variable.size",
     "(0.05 + variable.particle_random_3 * 0.08) * variable.size"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      16,
      32
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "math.lerp(variable.color.r, variable.color2.r, variable.particle_random_4)",
     "math.lerp(variable.color.g, variable.color2.g, variable.particle_random_4)",
     "math.lerp(variable.color.b, variable.color2.b, variable.particle_random_4)",
     "math.clamp(1 - variable.particle_age / variable.particle_lifetime, 0, 1)"
    ]
   }
  }
 }
}