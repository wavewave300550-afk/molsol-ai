{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "grimoire:plasma_charge",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/grimoire_particles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "5 + variable.size * 6"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.1
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "0.6 * variable.radius + 0.25",
    "surface_only": true,
    "direction": "inwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.38"
   },
   "minecraft:particle_initial_speed": "2.4 * variable.radius + 0.6",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0,
     0
    ],
    "linear_drag_coefficient": 1.0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.05 + 0.04 * variable.size",
     "0.18 + 0.1 * variable.size"
    ],
    "facing_camera_mode": "lookat_direction",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      0,
      48
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "math.lerp(variable.color.r, variable.color2.r, variable.particle_random_4)",
     "math.lerp(variable.color.g, variable.color2.g, variable.particle_random_4)",
     "math.lerp(variable.color.b, variable.color2.b, variable.particle_random_4)",
     "math.clamp(math.min(variable.particle_age * 8, (1 - variable.particle_age / variable.particle_lifetime) * 2.5), 0, 1)"
    ]
   }
  }
 }
}