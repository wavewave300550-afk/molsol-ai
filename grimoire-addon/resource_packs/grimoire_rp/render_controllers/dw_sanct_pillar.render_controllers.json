{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.grimoire.dw_sanct_pillar": {
   "geometry": "Array.geo[q.property('grimoire:kind')]",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Array.tex[q.property('grimoire:kind')]"
   ],
   "arrays": {
    "geometries": {
     "Array.geo": [
      "Geometry.default",
      "Geometry.k1"
     ]
    },
    "textures": {
     "Array.tex": [
      "Texture.default",
      "Texture.k1"
     ]
    }
   },
   "part_visibility": [
    {
     "*": true
    },
    {
     "letter*": "q.property('grimoire:state') == 1 || q.property('grimoire:state') == 2"
    },
    {
     "shard*": "q.property('grimoire:state') == 4"
    },
    {
     "quill*": "q.property('grimoire:state') == 2"
    },
    {
     "ribbon*": "q.property('grimoire:state') == 5"
    },
    {
     "flare*": "q.property('grimoire:state') == 6"
    }
   ]
  }
 }
}
