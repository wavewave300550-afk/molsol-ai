{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.grimoire.dn_guest_door": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    },
    {
     "corr_spill": "Material.blend"
    }
   ],
   "textures": [
    "Array.skin[q.property('grimoire:skin')]"
   ],
   "arrays": {
    "textures": {
     "Array.skin": [
      "Texture.default",
      "Texture.s1"
     ]
    }
   },
   "part_visibility": [
    {
     "*": true
    },
    {
     "corr*": "q.property('grimoire:state') >= 4 && q.property('grimoire:state') <= 6"
    }
   ]
  }
 }
}
