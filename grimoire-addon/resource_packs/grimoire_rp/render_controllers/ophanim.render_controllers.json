{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.grimoire.ophanim": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    },
    {
     "blur": "Material.blend"
    }
   ],
   "textures": [
    "Array.skin[q.property('grimoire:skin')]"
   ],
   "arrays": {
    "textures": {
     "Array.skin": [
      "Texture.default",
      "Texture.s1"
     ]
    }
   },
   "part_visibility": [
    {
     "*": true
    },
    {
     "letters": "q.property('grimoire:state') == 6"
    },
    {
     "blur": "q.property('grimoire:state') == 4"
    }
   ]
  }
 }
}
