{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "grimoire:ophanim",
   "materials": {
    "default": "entity_emissive_alpha",
    "blend": "entity_alphablend"
   },
   "textures": {
    "default": "textures/entity/grimoire/ophanim",
    "s1": "textures/entity/grimoire/ophanim__judging"
   },
   "geometry": {
    "default": "geometry.grimoire.ophanim"
   },
   "render_controllers": [
    "controller.render.grimoire.ophanim"
   ],
   "animations": {
    "turn": "animation.grimoire.ophanim.turn",
    "hidden": "animation.grimoire.ophanim.hidden",
    "arrive": "animation.grimoire.ophanim.arrive",
    "survey": "animation.grimoire.ophanim.survey",
    "lock": "animation.grimoire.ophanim.lock",
    "sweep": "animation.grimoire.ophanim.sweep",
    "verdict": "animation.grimoire.ophanim.verdict",
    "depart": "animation.grimoire.ophanim.depart",
    "ctl_main": "controller.animation.grimoire.ophanim.main"
   },
   "scripts": {
    "scale": "2.0",
    "initialize": [
     "v.spd = 0.0;",
     "v.ph = 0.0;",
     "v.tgt = 0.0;"
    ],
    "pre_animation": [
     "v.tgt = q.property('grimoire:state') == 4 ? 520.0 : (q.property('grimoire:state') == 5 ? 300.0 : (q.property('grimoire:state') == 3 ? 15.0 : (q.property('grimoire:state') == 6 ? 140.0 : (q.property('grimoire:state') == 1 ? 120.0 : 45.0))));",
     "v.spd = v.spd + (v.tgt - v.spd) * math.min(1.0, q.delta_time * 2.2);",
     "v.ph = math.mod(v.ph + v.spd * q.delta_time, 36000.0);"
    ],
    "animate": [
     "ctl_main",
     "turn"
    ],
    "should_update_bones_and_effects_offscreen": true
   },
   "sound_effects": {
    "clank": "grimoire.dw_ophan_clank",
    "chime": "grimoire.dw_ophan_eyes"
   }
  }
 }
}
