{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.grimoire.book_dw.turn": {
   "initial_state": "default",
   "states": {
    "default": {
     "transitions": [
      {
       "turn": "q.is_sneaking"
      }
     ],
     "blend_transition": 0.1
    },
    "turn": {
     "animations": [
      "turn"
     ],
     "transitions": [
      {
       "rest": "q.all_animations_finished"
      }
     ],
     "blend_transition": 0.1
    },
    "rest": {
     "transitions": [
      {
       "default": "!q.is_sneaking"
      }
     ],
     "blend_transition": 0.1
    }
   }
  }
 }
}
