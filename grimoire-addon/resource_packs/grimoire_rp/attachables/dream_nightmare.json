{"format_version":"1.10.0","minecraft:attachable":{"description":{"identifier":"grimoire:dream_nightmare","materials":{"default":"entity_alphatest","blend":"entity_alphablend"},"textures":{"default":"textures/entity/grimoire/book_dn_held"},"geometry":{"default":"geometry.grimoire.book_dn"},"animations":{"place":"animation.grimoire.book_dn.place","idle":"animation.grimoire.book_dn.idle","flip":"animation.grimoire.book_dn.flip","open":"animation.grimoire.book_dn.open","open_loop":"animation.grimoire.book_dn.open_loop","shut":"animation.grimoire.book_dn.shut","aura":"animation.grimoire.book_dn.aura","pose":"controller.animation.grimoire.book_dn.pose","hand_frame":"animation.grimoire.book_dn.hand_frame"},"scripts":{"pre_animation":["v.held = q.main_hand_item_use_duration > 0.0 ? math.max(q.main_hand_item_max_duration - q.main_hand_item_use_duration, 0.0) : 0.0;","v.target = q.main_hand_item_use_duration > 0.0 ? math.clamp(v.held / 8.0, 0.15, 1.0) : 0.0;","v.open_raw = math.max(v.target, math.clamp((v.open_raw ?? 0.0) - q.delta_time * 3.0, 0.0, 1.0));","v.open = v.open_raw * v.open_raw * (3.0 - 2.0 * v.open_raw);","v.press = q.is_sneaking && !(v.was_sneak ?? 0.0);","v.s0 = v.sel ?? 1.0;","v.sel = v.press ? (v.s0 < 1.0 ? math.min(v.s0, 0.17) : 0.0) : math.min(v.s0 + q.delta_time / 0.9, 1.0);","v.was_sneak = q.is_sneaking;","v.flare = v.sel < 0.17 ? math.sin(v.sel / 0.17 * 90.0) * 1.1 : (v.sel < 0.67 ? 1.1 - 0.2 * (v.sel - 0.17) : math.cos((v.sel - 0.67) / 0.33 * 90.0));","v.aura = math.max(v.sel < 1.0 ? v.flare : 0.0, v.open * 0.9);","v.spin1 = math.mod((v.spin1 ?? 0.0) + q.delta_time * (35.0 + 150.0 * v.open + 320.0 * (1.0 - v.sel)), 360.0);","v.spin2 = math.mod((v.spin2 ?? 0.0) - q.delta_time * (55.0 + 120.0 * v.open + 240.0 * (1.0 - v.sel)), 360.0);"],"animate":["hand_frame","place","idle","open",{"open_loop":"v.open"},"pose","aura"]},"render_controllers":["controller.render.grimoire.book_dn"]}}}
