{"format_version":"1.10.0","minecraft:attachable":{"description":{"identifier":"grimoire:elemental_dragon","materials":{"default":"entity_alphatest","blend":"entity_alphablend"},"textures":{"default":"textures/entity/grimoire/book_ed_held"},"geometry":{"default":"geometry.grimoire.book_ed"},"animations":{"place":"animation.grimoire.book_ed.place","idle":"animation.grimoire.book_ed.idle","closed":"animation.grimoire.book_ed.closed","turn":"animation.grimoire.book_ed.turn","open":"animation.grimoire.book_ed.open","open_loop":"animation.grimoire.book_ed.open_loop","aura":"animation.grimoire.book_ed.aura","ctl":"controller.animation.grimoire.book_ed.main","hand_frame":"animation.grimoire.book_ed.hand_frame"},"scripts":{"pre_animation":["v.held = q.main_hand_item_use_duration > 0.0 ? math.max(q.main_hand_item_max_duration - q.main_hand_item_use_duration, 0.0) : 0.0;","v.target = q.main_hand_item_use_duration > 0.0 ? math.clamp(v.held / 8.0, 0.15, 1.0) : 0.0;","v.open_raw = math.max(v.target, math.clamp((v.open_raw ?? 0.0) - q.delta_time * 3.0, 0.0, 1.0));","v.open = v.open_raw * v.open_raw * (3.0 - 2.0 * v.open_raw);","v.press = q.is_sneaking && !(v.was_sneak ?? 0.0);","v.s0 = v.sel ?? 1.0;","v.sel = v.press ? (v.s0 < 1.0 ? math.min(v.s0, 0.17) : 0.0) : math.min(v.s0 + q.delta_time / 0.9, 1.0);","v.was_sneak = q.is_sneaking;","v.flare = v.sel < 0.17 ? math.sin(v.sel / 0.17 * 90.0) * 1.1 : (v.sel < 0.67 ? 1.1 - 0.2 * (v.sel - 0.17) : math.cos((v.sel - 0.67) / 0.33 * 90.0));","v.aura = math.max(v.sel < 1.0 ? v.flare : 0.0, v.open * 0.9);","v.spin1 = math.mod((v.spin1 ?? 0.0) + q.delta_time * (35.0 + 150.0 * v.open + 320.0 * (1.0 - v.sel)), 360.0);","v.spin2 = math.mod((v.spin2 ?? 0.0) - q.delta_time * (55.0 + 120.0 * v.open + 240.0 * (1.0 - v.sel)), 360.0);"],"animate":["hand_frame","place","idle","open",{"open_loop":"v.open"},"ctl","aura"]},"sound_effects":{"flip":"grimoire.book_ed_flip"},"render_controllers":["controller.render.grimoire.book_ed"]}}}
