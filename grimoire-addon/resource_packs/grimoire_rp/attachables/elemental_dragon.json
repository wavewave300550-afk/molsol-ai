{"format_version":"1.10.0","minecraft:attachable":{"description":{"identifier":"grimoire:elemental_dragon","materials":{"default":"entity_alphatest","blend":"entity_alphablend"},"textures":{"default":"textures/entity/grimoire/book_ed_held"},"geometry":{"default":"geometry.grimoire.book_ed"},"animations":{"place":"animation.grimoire.book_ed.place","idle":"animation.grimoire.book_ed.idle","closed":"animation.grimoire.book_ed.closed","turn":"animation.grimoire.book_ed.turn","open":"animation.grimoire.book_ed.open","open_loop":"animation.grimoire.book_ed.open_loop","ctl":"controller.animation.grimoire.book_ed.main","hand_frame":"animation.grimoire.book_ed.hand_frame"},"scripts":{"pre_animation":["v.held = q.main_hand_item_use_duration > 0.0 ? math.max(q.main_hand_item_max_duration - q.main_hand_item_use_duration, 0.0) : 0.0;","v.target = q.main_hand_item_use_duration > 0.0 ? math.clamp(v.held / 8.0, 0.15, 1.0) : 0.0;","v.open = math.max(v.target, math.clamp((v.open ?? 0.0) - q.delta_time * 3.0, 0.0, 1.0));","v.open = v.open * v.open * (3.0 - 2.0 * v.open);"],"animate":["hand_frame","place","idle","open",{"open_loop":"v.open"},"ctl"]},"sound_effects":{"flip":"grimoire.book_ed_flip"},"render_controllers":["controller.render.grimoire.book_ed"]}}}
