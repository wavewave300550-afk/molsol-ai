{"format_version":"1.10.0","minecraft:attachable":{"description":{"identifier":"grimoire:divine_word","materials":{"default":"entity_alphatest"},"textures":{"default":"textures/entity/grimoire/book_dw_held"},"geometry":{"default":"geometry.grimoire.book_dw"},"animations":{"idle":"animation.grimoire.book_dw.idle","open":"animation.grimoire.book_dw.open","turn":"animation.grimoire.book_dw.turn","place_fp":"animation.grimoire.book_dw.place_fp","place_tp":"animation.grimoire.book_dw.place_tp","ctl_turn":"controller.animation.grimoire.book_dw.turn","hand_frame":"animation.grimoire.book_dw.hand_frame"},"scripts":{"pre_animation":["v.held = q.main_hand_item_use_duration > 0.0 ? math.max(q.main_hand_item_max_duration - q.main_hand_item_use_duration, 0.0) : 0.0;","v.target = q.main_hand_item_use_duration > 0.0 ? math.clamp(v.held / 8.0, 0.15, 1.0) : 0.0;","v.open_raw = math.max(v.target, math.clamp((v.open_raw ?? 0.0) - q.delta_time * 3.0, 0.0, 1.0));","v.open = v.open_raw * v.open_raw * (3.0 - 2.0 * v.open_raw);"],"animate":["hand_frame","idle","open",{"place_fp":"c.is_first_person"},{"place_tp":"!c.is_first_person"},"ctl_turn"]},"render_controllers":["controller.render.grimoire.book_dw"]}}}
