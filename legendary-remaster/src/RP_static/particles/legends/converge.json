{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "legends:converge",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/legends_fx"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": "variable.life * 0.7"
   },
   "minecraft:emitter_rate_steady": {
    "spawn_rate": "variable.count / math.max(0.1, variable.life * 0.7)",
    "max_particles": 200
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "variable.radius",
    "surface_only": true,
    "direction": "inwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.radius / math.max(0.1, variable.speed)"
   },
   "minecraft:particle_initial_speed": "variable.speed",
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "math.min(1.0, (variable.particle_age / variable.particle_lifetime) * 4.0)"
    ]
   },
   "minecraft:particle_appearance_billboard": {
    "facing_camera_mode": "lookat_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      0,
      96
     ],
     "uv_size": [
      32,
      32
     ]
    },
    "size": [
     "variable.size * (0.5 + (variable.particle_age / variable.particle_lifetime))",
     "variable.size * (0.5 + (variable.particle_age / variable.particle_lifetime))"
    ]
   }
  }
 }
}