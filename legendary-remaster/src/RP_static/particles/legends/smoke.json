{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "legends:smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/legends_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, variable.count)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.radius",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9 + variable.particle_random_1 * 0.8"
      },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.2,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_2 * 360",
        "rotation_rate": "(variable.particle_random_3 - 0.5) * 360"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1.0 - variable.particle_age / variable.particle_lifetime * 0.6"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            64,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "size": [
          "variable.size * 1.0",
          "variable.size * 1.0"
        ]
      }
    }
  }
}
