{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "legends:burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/legends_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, variable.count)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.radius",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.45 + variable.particle_random_1 * 0.4"
      },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1.0 - variable.particle_age / variable.particle_lifetime * 0.9"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "size": [
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)",
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)"
        ]
      }
    }
  }
}
