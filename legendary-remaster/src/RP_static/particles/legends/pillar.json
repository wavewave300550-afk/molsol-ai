{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "legends:pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/legends_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "variable.height * 0.5",
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1.0 - variable.particle_age / variable.particle_lifetime"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "size": [
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.6)",
          "variable.height * 0.5"
        ]
      }
    }
  }
}
